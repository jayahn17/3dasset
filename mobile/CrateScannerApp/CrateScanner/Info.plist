<?xml version="1.0" encoding="UTF-8"?>
<!--
    Info.plist for CrateScanner

    The two things ARKit needs:
      • NSCameraUsageDescription — REQUIRED. The app crashes on launch of the AR
        session without a camera-usage string. Edit the text to taste.
      • arkit UIRequiredDeviceCapabilities — restricts App Store installs to
        AR-capable devices. Combined with our runtime LiDAR check, unsupported
        hardware never reaches the scan.

    If your Xcode target uses an auto-generated Info.plist ("Generate Info.plist
    File" = Yes), add NSCameraUsageDescription under the target's Info tab
    instead of using this file. See the README.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSCameraUsageDescription</key>
    <string>CrateScanner uses the camera and LiDAR scanner to measure machines for custom crating.</string>

    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arkit</string>
    </array>

    <!--
        These two expose Documents/ in Files → On My iPad → CrateScanner, which
        is how a finished scan gets from the iPad to Google Drive (the Drive app
        registers as a Files provider) and on to Linux. Without them the folder
        exists but is invisible, and the only way off the device is the share
        sheet. See Support/ScanStorage.swift.
    -->
    <key>UIFileSharingEnabled</key>
    <true/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>

    <!--
        The app uploads scans to the assetpipe worker over Tailscale, i.e. plain
        http:// to a 100.x.y.z address. ATS blocks cleartext http by default, so
        we allow it here. This is an internal capture tool talking to your own
        worker on your own tailnet, not a public app. If you later serve the
        worker over https with a trusted cert, you can tighten this.
    -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
    <!--
        Connecting to a private-range worker IP can trip iOS's local-network
        permission prompt; this string is what that prompt shows.
    -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>CrateScanner uploads finished scans to your assetpipe worker on the local network / Tailscale.</string>

    <!--
        No Google URL scheme is needed here: ASWebAuthenticationSession captures
        the OAuth redirect itself. Paste your OAuth client ID into the app
        (review screen → Sync to Google Drive → Set up). See GoogleDriveConfig.swift.
    -->
</dict>
</plist>
