# publisher upload cache: blob URL per (dest, content hash) + the downscaled
# hero images. Machine-local state about what THIS box has already uploaded, so
# committing it would tell another checkout that files it has never sent are
# already live. web/.gitignore already excludes public/assets and
# public/manifest.json; leaving this one tracked was the asymmetry that made a
# stale-cache-vs-empty-store mismatch easy to hit.
.publish_cache/

# conda (temp requirements file written during `conda env create`)
env/condaenv.*.requirements.txt

# capture worker runtime data + self-signed TLS certs
worker_data/
*.pem

# roomscape scene bundles + blob store (~80 MB per room compressed)
roomscape/scenes/*
!roomscape/scenes/README.md
roomscape/blobs/

# node: only ever installed at the repo root to READ @vercel/blob's dist and
# confirm the API constants that integrations/blob.py reimplements in pure
# Python — nothing here is imported at runtime. package.json/-lock.json ARE
# tracked, because they pin the version those constants were checked against.
node_modules/

# python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
build/
dist/
.venv/
venv/

# scanner exports + generated assets (large binaries)
*.spz
*.sog
mouse_asset/
asset_out/
views/

# model weights (auto-downloaded by ultralytics; multi-hundred MB)
*.pt

# local, per-deployment list of Drive accounts to process (real email addresses)
captures/status/accounts_allow.json
