[Unit]
Description=Pull new CrateScanner packages from Google Drive into the inbox
After=network-online.target

[Service]
Type=oneshot
# The logic lives in a script rather than here because it is more than a copy:
# the app writes one subfolder per uploader, the watcher only reads the top
# level of the inbox, and processed zips must not be pulled a second time.
# See tools/drive_pull_to_inbox.sh.
ExecStart=%h/3dasset/tools/drive_pull_to_inbox.sh
Environment=DRIVE_REMOTE=gdrive:CrateScans
Environment=CAPTURES_DIR=%h/3dasset/captures
