[Unit]
Description=Pull new CrateScanner packages from Google Drive into the inbox
After=network-online.target

[Service]
Type=oneshot
# --min-age lets an in-progress Drive upload finish before we copy it.
ExecStart=/usr/bin/rclone copy gdrive:CrateScans/Packages %h/3dasset/captures/inbox \
    --include "*.zip" \
    --min-age 30s \
    --drive-shared-with-me \
    --log-level INFO
